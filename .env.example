# MinionQA Runtime Environment Configuration
# Supported providers: "openrouter", "cortensor", "openai"

# Primary / Development Inference Provider
MINIONQA_PROVIDER=openrouter
MINIONQA_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Cortensor Mainnet Full Alpha (Optional / Hosted Portal or Local Node)
# CORTENSOR_API_KEY=your-cortensor-portal-key-here
# CORTENSOR_PORTAL_URL=https://api.cortensor.app/v1
# CORTENSOR_BASE_URL=http://127.0.0.1:8080/api/v2/completions
